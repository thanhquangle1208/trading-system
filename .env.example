# Sao chép thành .env và điền khi có. Không commit file .env.

# --- Chung ---
APP_ENV=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_PATH=data/trading.db

# --- Paper ---
PAPER_STARTING_BALANCE_USDT=1000

# --- Bybit (ccxt) ---
# Chưa có key vẫn chạy được với MOCK_EXCHANGE=true hoặc adapter mock trong test.
EXCHANGE_ID=bybit
EXCHANGE_TESTNET=true
MOCK_EXCHANGE=true
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Telegram (Phase 1 chỉ skeleton; gửi tin thật ở Phase 6) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
