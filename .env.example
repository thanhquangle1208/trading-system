# Copy thành file .env (không commit lên GitHub)
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_CHAT_ID=123456789

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Giây giữa mỗi vòng chỉ lấy giá (ticker) khi đang theo dõi
WATCH_INTERVAL_SEC=45

# (Tuỳ chọn) cooldown giây giữa 2 tin cùng vùng — mặc định lấy từ watchlist (5 phút)
# ALERT_COOLDOWN_SEC=300
