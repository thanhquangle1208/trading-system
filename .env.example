# Sao chép thành .env khi chạy trên máy của bạn. Không commit file .env.
# Trên GitHub Actions, điền các giá trị này ở Settings → Secrets and variables → Actions.

# --- Telegram (BotFather + chat id) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notion (integration chỉ quyền đọc) ---
NOTION_TOKEN=
# Mặc định đã trỏ đúng database "Vùng giá gom token". Chỉ sửa nếu bạn đổi database.
NOTION_DATABASE_ID=41e859693b1581cc80bbfbcd6fe9e8c3
NOTION_DATA_SOURCE_ID=41e85969-3b15-815a-9e5e-000b774bd208

# --- Tùy chọn ---
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
# CoinGecko demo key — chỉ cần nếu gọi giá token nhỏ bị giới hạn. Để trống vẫn chạy được.
COINGECKO_API_KEY=

# Bật "đang tiến gần vùng" (phần trăm phía trên vùng). Để trống = tắt.
# BUY_ZONE_APPROACHING_PCT=3
# BUY_ZONE_HYSTERESIS_PCT=2
# BUY_ZONE_STATE_PATH=.state/buy_zones.json
