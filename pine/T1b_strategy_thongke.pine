// © Tomas Le — Thesis T1b: ít lệnh hơn + hộp PnL + bảng THỐNG KÊ (giống ảnh mẫu)
// Chart: BINANCE:BTCUSDT.P · 5m · vốn $10k · TP 2R · volume bắt buộc
// Cách dùng: Pine Editor → dán toàn bộ → Add to chart → xem hộp lệnh + bảng góc phải + tab Strategy Tester

//@version=5
strategy("Thesis T1b — THỐNG KÊ + hộp lệnh", overlay=true,
     initial_capital=10000, currency=currency.USD,
     commission_type=strategy.commission.percent, commission_value=0.055,
     process_orders_on_close=true, pyramiding=0,
     max_labels_count=500, max_lines_count=50, max_boxes_count=50)

//===== Inputs =====
atrLen       = input.int(10, "ATR length", minval=1, group="SuperTrend")
atrMult      = input.float(3.0, "ATR multiplier", minval=0.5, step=0.1, group="SuperTrend")
volLen       = input.int(20, "SMA Volume", minval=5, group="Volume (bắt buộc)")
volMult      = input.float(1.2, "Volume ≥ SMA ×", minval=0.5, step=0.1, group="Volume (bắt buộc)")
cooldownBars = input.int(12, "Cooldown giữa 2 lệnh (nến)", minval=0, group="Lọc lệnh")
slAtrMult    = input.float(1.5, "SL = ATR ×", minval=0.5, step=0.1, group="Risk")
tpR          = input.float(2.0, "TP (R)", minval=0.5, step=0.5, group="Risk")
riskPct      = input.float(1.0, "Risk % vốn / lệnh", minval=0.1, step=0.1, group="Risk")
feePctSide   = input.float(0.055, "Phí ước tính % / phía (label)", minval=0.0, step=0.001, group="Risk")
showBoxes    = input.bool(true, "Hộp Entry/SL/TP/PnL", group="Hiển thị")
showTable    = input.bool(true, "Bảng THỐNG KÊ", group="Hiển thị")

//===== SuperTrend (đường xanh/cam kiểu ảnh mẫu) =====
atr = ta.atr(atrLen)
src = hl2
var float up = na
var float dn = na
var int stDir = 1

up := src - atrMult * atr
dn := src + atrMult * atr
up := nz(close[1] > nz(up[1], up) ? math.max(up, up[1]) : up, up)
dn := nz(close[1] < nz(dn[1], dn) ? math.min(dn, dn[1]) : dn, dn)
stDir := close > nz(dn[1], dn) ? 1 : close < nz(up[1], up) ? -1 : stDir

stLine = stDir == 1 ? up : dn
plot(stLine, "SuperTrend", color=stDir == 1 ? color.aqua : color.orange, linewidth=2)

stFlipUp   = stDir == 1 and stDir[1] == -1
stFlipDown = stDir == -1 and stDir[1] == 1

volOk  = volume >= ta.sma(volume, volLen) * volMult
var int lastEntryBar = na
coolOk = na(lastEntryBar) or (bar_index - lastEntryBar >= cooldownBars)

longCond  = stFlipUp and volOk and coolOk
shortCond = stFlipDown and volOk and coolOk

atrSl    = atr * slAtrMult
riskCash = strategy.equity * riskPct / 100.0
rawQty   = atrSl > 0 ? riskCash / atrSl : 0.0

var float pendSl = na
var float pendTp = na
var float pendQty = na
var int   pendDir = 0

f_fee_est(float px, float q) =>
    px * q * feePctSide / 100.0 * 2.0

if longCond and rawQty > 0
    if strategy.position_size < 0
        strategy.close("Short", comment="Close Short before Long")
    pendSl  := close - atrSl
    pendTp  := close + atrSl * tpR
    pendQty := rawQty
    pendDir := 1
    strategy.entry("Long", strategy.long, qty=rawQty)
    strategy.exit("XL", from_entry="Long", stop=pendSl, limit=pendTp)
    lastEntryBar := bar_index
    if showBoxes
        label.new(bar_index, low,
             "LONG\nEntry: " + str.tostring(close, format.mintick) +
             "\nSL: " + str.tostring(pendSl, format.mintick) +
             "\nTP: " + str.tostring(pendTp, format.mintick) + " (" + str.tostring(tpR) + "R)" +
             "\nQty: " + str.tostring(pendQty, "#.###") +
             "\nPhi est: " + str.tostring(f_fee_est(close, pendQty), "#.##"),
             style=label.style_label_up, color=color.new(color.blue, 20), textcolor=color.white, size=size.small)

if shortCond and rawQty > 0
    if strategy.position_size > 0
        strategy.close("Long", comment="Close Long before Short")
    pendSl  := close + atrSl
    pendTp  := close - atrSl * tpR
    pendQty := rawQty
    pendDir := -1
    strategy.entry("Short", strategy.short, qty=rawQty)
    strategy.exit("XS", from_entry="Short", stop=pendSl, limit=pendTp)
    lastEntryBar := bar_index
    if showBoxes
        label.new(bar_index, high,
             "SHORT\nEntry: " + str.tostring(close, format.mintick) +
             "\nSL: " + str.tostring(pendSl, format.mintick) +
             "\nTP: " + str.tostring(pendTp, format.mintick) + " (" + str.tostring(tpR) + "R)" +
             "\nQty: " + str.tostring(pendQty, "#.###") +
             "\nPhi est: " + str.tostring(f_fee_est(close, pendQty), "#.##"),
             style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)

plotshape(longCond and rawQty > 0, title="Long", style=shape.triangleup, location=location.belowbar, color=color.aqua, size=size.small, text="L")
plotshape(shortCond and rawQty > 0, title="Short", style=shape.triangledown, location=location.abovebar, color=color.fuchsia, size=size.small, text="S")

// Hộp kết quả khi strategy vừa đóng 1 lệnh
newClosed = strategy.closedtrades > strategy.closedtrades[1]
if showBoxes and newClosed
    i = strategy.closedtrades - 1
    pft = strategy.closedtrades.profit(i)
    // commission may be available depending on TV build
    isWin = pft > 0
    side = strategy.closedtrades.size(i) > 0 ? "LONG" : "SHORT"
    col = isWin ? color.new(color.green, 15) : color.new(color.red, 15)
    y = isWin ? high : low
    stl = label.style_label_down
    label.new(bar_index, y,
         side + " đóng\nProfit: " + str.tostring(pft, "#.##") +
         "\nKết quả: " + (isWin ? "WIN" : "LOSS"),
         style=stl, color=col, textcolor=color.white, size=size.small)

//===== Bảng THỐNG KÊ =====
var table stats = table.new(position.top_right, 2, 15, bgcolor=color.new(#1a1028, 10), border_width=1, border_color=color.purple, frame_color=color.purple, frame_width=1)

f_cell(int r, string a, string b, color bc) =>
    table.cell(stats, 0, r, a, text_color=color.silver, text_size=size.small, bgcolor=color.new(#1a1028, 10))
    table.cell(stats, 1, r, b, text_color=color.white, text_size=size.small, bgcolor=bc)

f_date(int t) =>
    str.tostring(dayofmonth(t), "00") + "/" + str.tostring(month(t), "00") + "/" + str.tostring(year(t))

if showTable and barstate.islast
    n = strategy.closedtrades
    float gross = 0.0
    float fees = 0.0
    float wins = 0.0
    float losses = 0.0
    int nWin = 0
    int nLoss = 0
    int tFirst = na
    int tLast = na
    if n > 0
        for i = 0 to n - 1
            p = strategy.closedtrades.profit(i)
            // gross ≈ profit + commission (commission thường âm)
            c = strategy.closedtrades.commission(i)
            gross += p - c
            fees += math.abs(c)
            if p > 0
                nWin += 1
                wins += p
            else
                nLoss += 1
                losses += math.abs(p)
        tFirst := strategy.closedtrades.entry_time(0)
        tLast := strategy.closedtrades.exit_time(n - 1)

    net = strategy.netprofit
    wr = n > 0 ? nWin * 100.0 / n : 0.0
    pf = losses > 0 ? wins / losses : (wins > 0 ? 999.0 : 0.0)
    avgNet = n > 0 ? net / n : 0.0
    avgFee = n > 0 ? fees / n : 0.0
    curCap = strategy.initial_capital + net
    maxDD = strategy.max_drawdown / strategy.initial_capital * 100.0
    netCol = net >= 0 ? color.new(color.green, 70) : color.new(color.red, 70)
    d1 = na(tFirst) ? "—" : f_date(tFirst)
    d2 = na(tLast) ? "—" : f_date(tLast)

    table.cell(stats, 0, 0, "THỐNG KÊ", text_color=color.white, text_size=size.normal, bgcolor=color.new(color.purple, 40))
    table.cell(stats, 1, 0, "Thesis T1b", text_color=color.silver, text_size=size.small, bgcolor=color.new(color.purple, 40))
    f_cell(1, "Từ ngày", d1, color.new(#1a1028, 10))
    f_cell(2, "Đến ngày", d2, color.new(#1a1028, 10))
    f_cell(3, "Vốn ban đầu", str.tostring(strategy.initial_capital, "#.##") + " $", color.new(#1a1028, 10))
    f_cell(4, "Vốn hiện tại", str.tostring(curCap, "#.##") + " $", color.new(color.yellow, 70))
    f_cell(5, "Tổng lệnh", str.tostring(n), color.new(#1a1028, 10))
    f_cell(6, "Thắng / Thua", str.tostring(nWin) + " / " + str.tostring(nLoss), color.new(#1a1028, 10))
    f_cell(7, "Win Rate", str.tostring(wr, "#.##") + "%", color.new(#1a1028, 10))
    f_cell(8, "Gross LN", str.tostring(gross, "#.##") + " $", netCol)
    f_cell(9, "Net LN", str.tostring(net, "#.##") + " $", netCol)
    f_cell(10, "Profit Factor", str.tostring(pf, "#.##"), netCol)
    f_cell(11, "Tổng phí", "-" + str.tostring(fees, "#.##") + " $", color.new(#1a1028, 10))
    f_cell(12, "LN TB/lệnh", str.tostring(avgNet, "#.####") + " $", netCol)
    f_cell(13, "Max DD %", str.tostring(maxDD, "#.##") + "%", color.new(color.red, 70))
    f_cell(14, "Phí TB/lệnh", str.tostring(avgFee, "#.####") + " $", color.new(#1a1028, 10))
