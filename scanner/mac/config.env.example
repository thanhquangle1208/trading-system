# Copy thành config.env (không commit nếu có thông tin nhạy cảm — file này chỉ đường dẫn/nhánh)

# Đường dẫn repo trên Mac (đổi nếu bạn clone chỗ khác)
REPO_DIR="$HOME/trading-system"

# Nhánh agent cloud đẩy code
GIT_BRANCH="cursor/trading-thesis-pine-de71"

# Bao nhiêu giây kiểm tra một lần (300=5 phút, 600=10 phút, 900=15 phút)
CHECK_EVERY_SEC=600
